signals
signal piece_selected, player_turn: std_logic;    			-- 1 bit data that a piece is currently selected, and 1 bit data for which player's turn it is
signal square_over: std_logic_vector(5 downto 0);			-- 6 bit data for the square player is on, first 3 bits for the row, last three for the column
signal row_over, col_over: std_logic_vector(2 downto 0);	-- 3 bit data for the row player is on, from first 3 bits of square_over, and 3 bit data for the column player is on, from last 3 bits of square_over
signal bit_high, bit_low: std_logic_vector(2 downto 0); 	-- 3 bit signals for the start and end of the column bits selected for the piece data from the boardstate_ROM
boardstate_ROM												-- 8 rows of 32 bit data for the board state 
piece_data													-- 4 bit signal for transferring piece 4 bit data


-- detect and store data on piece selected
process()
	square_over <= "000000";
	col_over <= "000";
	row_over <= "000";
	piece_data <= "1000";  							--at start if square_over is on 0,0 the piece we're looking at is a black pawn
	piece_selected <= '0';
	boardstate_ROM <= 
	
	if (enter = '1') then
		if piece_selected <= 0 																						--if we're picking up a piece
			row_over <= square_over(2 downto 0);
			col_over <= square_over(5 downto 3);
			bit_high <= ((to_integer(square_over(5 downto 3)))*4)+3;
			bit_low <= (to_integer(square_over(5 downto 3))*4);
			piece_data <= boardstate_ROM(to_integer(row_data))(to _integer(bit_high) downto to_integer(bit_low));
			boardstate_ROM(to_integer(row_over))(to_integer(bit_high) downto to_integer(bit_low)) <= "0111";		--assign the square piece picked up from to be an empty square
			piece_selected <= 1;
		else
			boardstate_ROM(to_integer(row_over)(to_integer(bit_high) downto to_integer(bit_low)) <= piece_data;
			if player_turn = 1																						--switch player turn when placing piece
				player_turn <= 0;
				square_over <= ;
			else
				player_turn <= 1;
				square_over <= ;
			end if;
			piece_selected <= 0;
		end if;
	end if;
	
-- detect movement (change value of square_over) based on key presses
	if (left arrow = '1') then
		if col_over <= "000"    							--detect if we're on the zero column so that we dont move off the board
			col_over <= "000";
			wait;
		else 
			square_over <= row_over & (col_over - 1);
			wait;
		end if;
	end if;
	
	if (right arrow = '1') then
		if col_over <= "111"   								--detect if we're on the seven column so that we dont move off the board
			col_over <= "111";
			wait;
		else
			square_over <= row_over & (col_over + 1);
			wait;
		end if;
	end if;
	
	if (up arrow = '1') then
		if row_over <= "000";   							--detect if we're on the zero (top) row so that we dont move off the board
			row_over <= "000";
			wait;
		else
			square_over <= (row_over + 1) & col_over;		--think of the array structure for why its + instead of - here
			wait;
		end if;
	end if;
	
	if (down arrow = '1') then
		if row_over <= "111";   							--detect if we're on the seven (bottom) row so that we dont move off the board
			row_over <= "111";
			wait;
		else
			square_over <= (row_over - 1) & col_over;
			wait;
		end if;
	end if;
	
end process;
